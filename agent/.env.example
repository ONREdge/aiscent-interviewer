# LiveKit Cloud project credentials (Project settings → Keys).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Model provider keys (all three are required).
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# The Express backend deployed alongside this agent. The agent posts
# advance/complete events here and delivers the final session JSON to
# ${API_BASE_URL}/aiscent-session (or AISCENT_RESULTS_ENDPOINT if set).
API_BASE_URL=https://your-backend.up.railway.app
# Optional — overrides the default of ${API_BASE_URL}/aiscent-session.
AISCENT_RESULTS_ENDPOINT=
