# HTTP port the Express server binds to. Railway sets this automatically.
PORT=3000

# CORS: the exact origin of your deployed frontend. Use * for local dev.
FRONTEND_URL=https://your-frontend.vercel.app

# SendGrid — obtain from https://app.sendgrid.com/settings/api_keys
# Key must have at minimum the "Mail Send" scope.
SENDGRID_API_KEY=SG.xxxxx

# The verified single-sender email address you set up in SendGrid.
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=AiSCENT

# Where finished interview JSON gets delivered.
AISCENT_RESULTS_EMAIL_TO=bespokecsi.dev@gmail.com
