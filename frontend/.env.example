# LiveKit Cloud project credentials — the frontend mints a JWT for the
# in-browser participant. Get these from LiveKit Cloud → Project → Keys.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The public URL of the deployed Express backend. The AISCENT hooks POST
# and open SSE streams against this base URL.
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app
